# Copy to .env.local for local overrides. On Vercel, set these under Project → Settings → Environment Variables.
# All values are optional; the defaults in src/lib are used when unset.

# Canonical site URL for metadata, sitemap and robots (no trailing slash).
# On Vercel this falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=

# EmailJS (contact form). These are public browser keys; restrict "Allowed origins" in the EmailJS dashboard.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
